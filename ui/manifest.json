{
  "schema": "pom-plugin-ui/v1",
  "plugin_code": "hermes",
  "lifecycle": "resident",
  "icon_image": "ui/icon.png",
  "description": {
    "en": "Install Hermes Agent and open its dashboard inside POM.",
    "pt-BR": "Instale o Hermes Agent e abra seu painel dentro do POM."
  },
  "documentation": {
    "guides": [
      {
        "id": "getting-started",
        "title": {"en": "Getting started", "pt-BR": "Primeiros passos"},
        "asset": "docs/getting-started.md"
      }
    ],
    "reference": []
  },
  "menu": [
    {
      "id": "hermes",
      "label": {"en": "Hermes Agent", "pt-BR": "Hermes Agent"},
      "icon": "blocks",
      "to": "/main"
    }
  ],
  "routes": [
    {"path": "/main", "screen": "main", "full_bleed": false}
  ],
  "screens": {
    "main": {"module": "ui/screens.js", "export": "main", "styles": ["ui/plugin.css"]}
  },
  "i18n": {
    "en": "i18n/en.json",
    "pt-BR": "i18n/pt-BR.json"
  },
  "development": {
    "rebuild": [
      {"run": ["scripts/dev-ui.sh"], "os": ["linux", "macos"]}
    ]
  },
  "assets": [
    "ui/screens.js",
    "ui/plugin.css",
    "ui/icon.png",
    "i18n/en.json",
    "i18n/pt-BR.json",
    "docs/getting-started.md"
  ]
}
